# --- Gemini (optional) ---------------------------------------------------
# Without this the ReAct loop is skipped and the deterministic tool pipeline
# plus the grounded template generator produce the answer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=1024
AGENT_MAX_ITERATIONS=8

# --- Government data (optional) -------------------------------------------
# Register at https://data.gov.in to obtain an Agmarknet API key. Without it
# the service serves the bundled reference dataset and flags every response
# as degraded.
AGMARKNET_API_KEY=

# --- Internet search (optional) -------------------------------------------
TAVILY_API_KEY=

# --- Service --------------------------------------------------------------
# Set OFFLINE_MODE=1 to disable every outbound call, for demos and CI.
OFFLINE_MODE=0
RAG_TOP_K=5
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
