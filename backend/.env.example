PORT=5000
NODE_ENV=development

# Leave MONGO_URI empty to run with the in-memory store (no persistence).
MONGO_URI=

# Must be a real secret in production — the server refuses to start otherwise.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000

# Price cache lifetime; the report measures ~1.8 s cached vs ~4.2 s live.
MANDI_CACHE_TTL_MS=1800000

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- WhatsApp Business API (Section 6.3) ----------------------------------
# All optional. Without them /api/whatsapp reports itself unconfigured and the
# rest of the gateway is unaffected.
# WHATSAPP_TOKEN and WHATSAPP_PHONE_NUMBER_ID come from the Meta app dashboard.
# WHATSAPP_VERIFY_TOKEN is a string you choose and enter in the webhook setup.
# WHATSAPP_APP_SECRET signs inbound webhooks; without it every inbound message
# is rejected, which is the safe default for a publicly reachable endpoint.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
